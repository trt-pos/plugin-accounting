<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.lebastudios.theroundtable.components.IconButton?>
<?import org.lebastudios.theroundtable.components.DateRangePicker?>
<VBox alignment="CENTER" spacing="5" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.lebastudios.theroundtable.pluginaccounting.MainPaneController">
    <padding>
        <Insets bottom="5" left="5" right="5" top="5"/>
    </padding>
    <HBox alignment="CENTER" spacing="15">
        <DateRangePicker fx:id="dateRangePicker" />
        <Region HBox.hgrow="ALWAYS"/>
        <IconButton iconName="accounting:menu.png"/>
    </HBox>
    <TitledPane expanded="false" text="Filters">
        <content>
            <VBox spacing="5">
                <HBox spacing="5">
                    <Label text="Employee" />
                    <ChoiceBox fx:id="employeeChoiceBox" prefWidth="250"/>
                </HBox>
                <HBox spacing="5">
                    <RadioButton fx:id="cashRadioButton" text="Cash" selected="true"/>
                    <RadioButton fx:id="creditRadioButton" text="Credit" selected="true"/>
                </HBox>
            </VBox>
        </content>
    </TitledPane>
    <TableView fx:id="tableView" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="dateColumn" text="Date"/>
            <TableColumn fx:id="employeeColumn" text="Employee"/>
            <TableColumn fx:id="conceptColumn" text="Concept"/>
            <TableColumn fx:id="methodColumn" text="Method"/>
            <TableColumn fx:id="qtyColumn" text="Qty"/>
            <TableColumn fx:id="totalColumn" text="Total"/>
        </columns>
    </TableView>
    <HBox alignment="CENTER_RIGHT">
        <Label text="Total: 45 €"/>
    </HBox>
</VBox>
