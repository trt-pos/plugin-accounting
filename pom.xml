<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.lebastudios.theroundtableplugins</groupId>
    <artifactId>accounting</artifactId>
    <version>3.0.0</version>
    <name>accounting</name>
    <packaging>jar</packaging>

    <parent>
        <groupId>com.github.trt-pos</groupId>
        <artifactId>the-round-table</artifactId>
        <version>dev-v3.0.0-SNAPSHOT</version>
    </parent>
    
    <dependencies>
        <dependency>
            <groupId>com.github.trt-pos</groupId>
            <artifactId>core</artifactId>
            <version>dev-v3.0.0-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.github.trt-pos</groupId>
            <artifactId>plugin-cash-register</artifactId>
            <version>dev-v3.0.0-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>
    
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.2.0</version>
                <configuration>
                    <outputDirectory>${project.build.directory}</outputDirectory>
                    <finalName>${project.artifactId}</finalName>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.github.trt-pos</groupId>
                <artifactId>t-cleaner</artifactId>
            </plugin>
        </plugins>
    </build>
</project>